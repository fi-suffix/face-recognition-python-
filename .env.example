LARAVEL_API_URL=http://localhost:8000/api
# Samakan dengan FACE_RECOGNITION_API_KEY di aplikasi Laravel
LARAVEL_API_KEY=your-secret-api-key-here

# Threshold lebih rendah berarti pencocokan wajah lebih longgar
FACE_RECOGNITION_THRESHOLD=0.45
CAMERA_RECONNECT_INTERVAL=5
LOG_COOLDOWN=3
# Minimum detik antar proses recognition per wajah (bikin video tetep adem)
RECOGNITION_INTERVAL=2.0
MAX_STREAM_WIDTH=960
STREAM_FPS=20

# ===== Performance tuning (anti-lag) =====
DETECTION_INTERVAL=0.25
DETECT_FRAME_WIDTH=640
LOOP_FPS=15
YUNET_CONFIDENCE_THRESHOLD=0.5
GOOD_FRAME_CONFIDENCE=0.6
MIN_FACE_WIDTH=20
RECOGNITION_WORKERS=2
# Migration embedding: true sekali untuk re-encode semua embedding dengan aligned SFace
RECOMPUTE_EMBEDDINGS_ON_START=false
LARAVEL_API_URL=http://localhost:8000/api
# Samakan dengan FACE_RECOGNITION_API_KEY di aplikasi Laravel
LARAVEL_API_KEY=your-secret-api-key-here

# Threshold lebih rendah berarti pencocokan wajah lebih longgar
FACE_RECOGNITION_THRESHOLD=0.45
CAMERA_RECONNECT_INTERVAL=5
LOG_COOLDOWN=3
# Minimum detik antar proses recognition per wajah (bikin video tetep adem)
RECOGNITION_INTERVAL=2.0
# Teruji halus untuk 5 kamera (load python +- 4-5 core). Naikkan bertahap bila CPU longgar.
MAX_STREAM_WIDTH=640
STREAM_FPS=10

# ===== Sensitivitas deteksi wajah (kamera tinggi / wajah kecil) =====
# Ambang skor YuNet (rendah = lebih sensitif, wajah kecil/jauh ikut terdeteksi)
FACE_DETECTION_CONFIDENCE=0.5
# Perbesaran frame sebelum deteksi (1.0 = mati) -- koordinat dipetakan kembali otomatis
DETECT_UPSCALE=1.5
# Margin crop wajah sebelum di-embed (pecahan dari ukuran bbox, misal 0.2 = +20%)
FACE_CROP_MARGIN=0.2

# ===== Performance tuning (anti-lag) =====
# Deteksi YuNet di-frame per beberapa detik (bukan tiap frame) supaya CPU adem
DETECTION_INTERVAL=0.25
# Leber frame yang dipakai buat deteksi (kotak di-mapping balik ke stream)
DETECT_FRAME_WIDTH=640
# Target FPS loop capture per kamera
LOOP_FPS=15
YUNET_CONFIDENCE_THRESHOLD=0.5
# Hanya proses-crop dengan confidence di atas ini yang di-recognize
GOOD_FRAME_CONFIDENCE=0.6
# Lebar wajah minimum (px, di frame deteksi)
MIN_FACE_WIDTH=20
# Worker recognition (4 = beban CPU tinggi; 2 cukup untuk CPU 2-core)
RECOGNITION_WORKERS=2
# Migration embedding: true sekali untuk re-encode semua embedding dengan aligned SFace
RECOMPUTE_EMBEDDINGS_ON_START=false
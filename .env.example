LARAVEL_API_URL=http://localhost:8000/api
# Samakan dengan FACE_RECOGNITION_API_KEY di aplikasi Laravel
LARAVEL_API_KEY=your-secret-api-key-here

# Threshold lebih rendah berarti pencocokan wajah lebih longgar
FACE_RECOGNITION_THRESHOLD=0.45
CAMERA_RECONNECT_INTERVAL=5
LOG_COOLDOWN=3
RECOGNITION_EVERY_N_FRAMES=2
# Minimum detik antar proses recognition per kamera
RECOGNITION_INTERVAL=2.0
MAX_STREAM_WIDTH=640
STREAM_FPS=10

# === Sensitivitas deteksi wajah (kamera tinggi / wajah kecil) ===
# Semakin rendah => mendeteksi wajah kualitas rendah (bisa lebih banyak false positive)
YUNET_CONFIDENCE_THRESHOLD=0.5
# Perbesaran frame sebelum pendeteksian (1.0 = mati, 1.5 = wajah kecil lebih terdeteksi)
DETECT_UPSCALE=1.5
# Margin crop wajah sebelum di-embed (konversi ke persen bbox, misal 0.2 = +20%)
FACE_CROP_MARGIN=0.2
# Deteksi YuNet tiap N frame (2 = tiap 2 frame; naikkan untuk kurangi beban CPU)
DETECT_EVERY_N_FRAMES=2
# CLAHE pada frame deteksi untuk video burik (1 = nyala, hanya memengaruhi deteksi)
DETECT_ENHANCE=1
# Wajah lebih kecil dari ini (px, di lebar stream) tidak di-recognisi/di-log (buang noise)
MIN_FACE_SIZE=24
# Maksimal wajah yang diproses recognition per jendela gate (ambil yang terbesar)
RECOGNITION_MAX_FACES=2
# Thread recognition (maks utk SFace+HTTP+snapshot; lebih kecil = CPU lebih ringan)
RECOGNITION_WORKERS=2

# ============================================
# FALL DETECTION (Emergency Alert System)
# ============================================
# Aktifkan deteksi jatuh/pingsan (0 = mati, 1 = nyala)
FALL_DETECTION_ENABLED=1
# Interval deteksi pose dalam detik (semakin kecil = lebih responsif tapi lebih berat)
FALL_DETECTION_INTERVAL=1.0
# Sudut tubuh (derajat) dari vertikal untuk dianggap jatuh (45 = cukup akurat)
FALL_ANGLE_THRESHOLD=45
# Durasi (detik) seseorang harus terbaring sebelum alert dipicu
FALL_DURATION_THRESHOLD=3.0
# Ambang kepercayaan deteksi pose MediaPipe
FALL_CONFIDENCE_THRESHOLD=0.5
# Aktifkan suara alert (0 = mati, 1 = nyala)
ALERT_SOUND_ENABLED=1
# Path ke file suara alert (kosongkan untuk default)
ALERT_SOUND_PATH=
# Berapa kali suara alert diulang
ALERT_REPEAT_COUNT=3